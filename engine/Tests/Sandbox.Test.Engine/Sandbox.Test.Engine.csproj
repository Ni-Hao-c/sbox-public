<Project Sdk="Microsoft.NET.Sdk">

	<!-- Engine-attached tests: loads the native engine DLLs (interop) but never boots the engine loop (see Assembly.cs). Needs FACEPUNCH_ENGINE. -->

	<PropertyGroup>
		<!-- This executable test project has no project consumers. Only its implementation
		     assembly is needed; avoid requiring a separate refint assembly at copy time. -->
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Microsoft.AspNetCore.Components" />
		<Using Include="Microsoft.AspNetCore.Components.Rendering" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Facepunch.ActionGraphs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Mounting\Sandbox.Mounting.Titanfall2\Sandbox.Mounting.Titanfall2.csproj" />
		<ProjectReference Include="..\..\Sandbox.Bind\Sandbox.Bind.csproj" />
		<ProjectReference Include="..\..\Sandbox.ContentBuild\Sandbox.ContentBuild.csproj" />
		<ProjectReference Include="..\..\Sandbox.Generator\Sandbox.Generator.csproj" />
		<ProjectReference Include="..\..\Sandbox.System\Sandbox.System.csproj" />
		<ProjectReference Include="..\..\Sandbox.Engine\Sandbox.Engine.csproj" />
		<ProjectReference Include="..\..\Sandbox.Tools\Sandbox.Tools.csproj" />
		<ProjectReference Include="..\..\Sandbox.Menu\Sandbox.Menu.csproj" />
		<ProjectReference Include="..\..\Sandbox.AppSystem\Sandbox.AppSystem.csproj" />
	</ItemGroup>

</Project>
