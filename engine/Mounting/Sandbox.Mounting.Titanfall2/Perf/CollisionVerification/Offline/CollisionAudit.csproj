    <Compile Include="$(MountSourceRoot)/Formats/Titanfall2LightProbe.cs" Link="Titanfall2LightProbe.cs" />
    <Compile Include="$(MountSourceRoot)/Formats/Titanfall2WorldLight.cs" Link="Titanfall2WorldLight.cs" />
    <Compile Include="$(MountSourceRoot)/Formats/Titanfall2EntityText.cs" Link="Titanfall2EntityText.cs" />
    <None Include="$(MountSourceRoot)/../../../game/mount/titanfall2/titanfall2_lzham.dll" Link="titanfall2_lzham.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
