    <AssemblyName>Sandbox.Test.Integration</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Official/Official.csproj" />
